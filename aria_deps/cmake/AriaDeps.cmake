# Shared source-dependency integration, installed by aria-deps.
# Resolution writes only build-local effective metadata. Fetches use the
# package's verified cache; this bridge contains no download/extraction code.
include_guard(GLOBAL)

function(_aria_deps_run output)
    if(AriaDeps_PYTHON_EXECUTABLE)
        set(_python "${AriaDeps_PYTHON_EXECUTABLE}")
    else()
        find_package(Python3 3.10 QUIET COMPONENTS Interpreter)
        if(NOT Python3_Interpreter_FOUND)
            message(FATAL_ERROR "AriaDeps requires Python 3.10+ for resolution or source fetching")
        endif()
        set(_python "${Python3_EXECUTABLE}")
    endif()
    execute_process(COMMAND "${_python}" -m aria_deps ${ARGN}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "AriaDeps command failed (${_result}):\n${_output}${_error}")
    endif()
    set(${output} "${_output}" PARENT_SCOPE)
endfunction()

# Output arguments name variables in the caller's scope. Source metadata is
# never modified by configure: the package owns validation and effective locks.
function(aria_deps_resolve)
    cmake_parse_arguments(DEP "OFFLINE" "NAME;FILE;REQUEST_VERSION;CACHE;STATE_DIR;VERSION;URL;SHA256;REVISION;TAG" "" ${ARGN})
    if(NOT DEP_NAME OR NOT DEP_FILE OR DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "aria_deps_resolve: expected NAME, FILE and output-variable arguments")
    endif()
    string(TOLOWER "${DEP_NAME}" _name)
    get_filename_component(_file "${DEP_FILE}" ABSOLUTE)
    string(SHA256 _identity "${_file}")
    set(_state "${CMAKE_BINARY_DIR}/deps/ariadeps")
    if(DEP_STATE_DIR)
        set(_state "${DEP_STATE_DIR}")
    endif()
    set(_effective "${_state}/${_identity}/dependencies.json")
    set(_cache "${DEP_CACHE}")
    if(NOT _cache)
        set(_cache "${_state}/downloads")
    endif()
    set(_arguments resolve --file "${_file}" --output "${_effective}"
        --cache "${_cache}" --only "${_name}")
    if(DEP_REQUEST_VERSION)
        list(APPEND _arguments --version "${_name}=${DEP_REQUEST_VERSION}")
    endif()
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    _aria_deps_run(_result ${_arguments})
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}" "${_effective}")
    endif()
    foreach(_field VERSION URL SHA256 REVISION TAG)
        if(DEP_${_field})
            string(TOLOWER "${_field}" _key)
            string(JSON _value ERROR_VARIABLE _error GET "${_result}" dependencies "${_name}" "${_key}")
            if(_error)
                message(FATAL_ERROR "AriaDeps returned no ${_key} for ${_name}: ${_result}")
            endif()
            set(${DEP_${_field}} "${_value}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# Explicit metadata keeps this primitive usable by any schema/provider.
function(aria_deps_fetch_archive)
    cmake_parse_arguments(DEP "OFFLINE" "NAME;VERSION;URL;SHA256;CACHE;SOURCE_DIR;ARCHIVE" "" ${ARGN})
    if(DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "aria_deps_fetch_archive: invalid arguments")
    endif()
    foreach(_required NAME VERSION URL SHA256 CACHE SOURCE_DIR)
        if(NOT DEP_${_required})
            message(FATAL_ERROR "aria_deps_fetch_archive: missing ${_required}")
        endif()
    endforeach()
    set(_arguments fetch-archive --name "${DEP_NAME}" --version "${DEP_VERSION}"
        --url "${DEP_URL}" --sha256 "${DEP_SHA256}" --cache "${DEP_CACHE}")
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    _aria_deps_run(_result ${_arguments})
    string(JSON _source ERROR_VARIABLE _error GET "${_result}" source_dir)
    if(_error OR NOT IS_DIRECTORY "${_source}")
        message(FATAL_ERROR "AriaDeps returned an invalid source directory: ${_result}")
    endif()
    file(TO_CMAKE_PATH "${_source}" _source)
    set(${DEP_SOURCE_DIR} "${_source}" PARENT_SCOPE)
    if(DEP_ARCHIVE)
        string(JSON _archive GET "${_result}" archive)
        file(TO_CMAKE_PATH "${_archive}" _archive)
        set(${DEP_ARCHIVE} "${_archive}" PARENT_SCOPE)
    endif()
endfunction()

function(aria_deps_fetch_file)
    cmake_parse_arguments(DEP "OFFLINE" "NAME;URL;SHA256;CACHE;AS;FILE;BASE" "" ${ARGN})
    if(DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "aria_deps_fetch_file: invalid arguments")
    endif()
    foreach(_required NAME URL SHA256 CACHE FILE)
        if(NOT DEP_${_required})
            message(FATAL_ERROR "aria_deps_fetch_file: missing ${_required}")
        endif()
    endforeach()
    set(_arguments fetch-file --name "${DEP_NAME}" --url "${DEP_URL}"
        --sha256 "${DEP_SHA256}" --cache "${DEP_CACHE}")
    if(DEP_AS)
        list(APPEND _arguments --as "${DEP_AS}")
    endif()
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    _aria_deps_run(_result ${_arguments})
    string(JSON _file ERROR_VARIABLE _error GET "${_result}" file)
    if(_error OR NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
        message(FATAL_ERROR "AriaDeps returned an invalid file: ${_result}")
    endif()
    file(TO_CMAKE_PATH "${_file}" _file)
    set(${DEP_FILE} "${_file}" PARENT_SCOPE)
    if(DEP_BASE)
        string(JSON _base GET "${_result}" base)
        file(TO_CMAKE_PATH "${_base}" _base)
        set(${DEP_BASE} "${_base}" PARENT_SCOPE)
    endif()
endfunction()
