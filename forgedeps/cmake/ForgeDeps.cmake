# Shared source-dependency integration, installed by forgedeps.
# Resolution writes only build-local effective metadata. Fetches use the
# package's verified cache; this bridge contains no download/extraction code.
include_guard(GLOBAL)

function(_forgedeps_run output)
    if(ForgeDeps_PYTHON_EXECUTABLE)
        set(_python "${ForgeDeps_PYTHON_EXECUTABLE}")
    else()
        find_package(Python3 3.14 QUIET COMPONENTS Interpreter)
        if(NOT Python3_Interpreter_FOUND)
            message(FATAL_ERROR "ForgeDeps requires Python 3.14+ for resolution or source fetching")
        endif()
        set(_python "${Python3_EXECUTABLE}")
    endif()
    execute_process(COMMAND "${_python}" -m forgedeps ${ARGN}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "ForgeDeps command failed (${_result}):\n${_output}${_error}")
    endif()
    set(${output} "${_output}" PARENT_SCOPE)
endfunction()

# Consume the exact generations selected by a build driver. For a complete
# configure/build/test/install session, run the driver through forgedeps run.
# Reconfiguration depends on both the selection and every stable-slot manifest.
function(forgedeps_use_environment)
    cmake_parse_arguments(DEP "" "FILE;OUTPUT_PREFIXES;PREFIXES" "" ${ARGN})
    if(NOT DEP_FILE)
        set(DEP_FILE "${FORGEDEPS_ENVIRONMENT}")
    endif()
    if(NOT DEP_FILE)
        set(DEP_FILE "$ENV{FORGEDEPS_ENVIRONMENT}")
    endif()
    if(NOT DEP_FILE OR DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "forgedeps_use_environment requires FILE or FORGEDEPS_ENVIRONMENT")
    endif()
    get_filename_component(_file "${DEP_FILE}" ABSOLUTE)
    _forgedeps_run(_verified verify-environment --environment "${_file}")
    string(JSON _count LENGTH "${_verified}" prefixes)
    set(_prefixes)
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _prefix GET "${_verified}" prefixes ${_index})
            file(TO_CMAKE_PATH "${_prefix}" _prefix)
            list(APPEND _prefixes "${_prefix}")
            if(NOT CMAKE_SCRIPT_MODE_FILE)
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_prefix}/manifest.json")
            endif()
        endforeach()
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    endif()
    set(_search ${_prefixes} ${CMAKE_PREFIX_PATH})
    list(REMOVE_DUPLICATES _search)
    set(CMAKE_PREFIX_PATH "${_search}" PARENT_SCOPE)
    set(FORGEDEPS_ENVIRONMENT "${_file}" PARENT_SCOPE)
    foreach(_output OUTPUT_PREFIXES PREFIXES)
        if(DEP_${_output})
            set(${DEP_${_output}} "${_prefixes}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# Inject a project policy into the shared store. This is intended after project()
# so the real target compiler and normal (not only cache) ABI settings are known.
function(forgedeps_environment)
    cmake_parse_arguments(DEP "OFFLINE;CHECK" "FILE;PROJECT_CONFIG;ONLY;OUTPUT;PREFIXES;PROFILE;TLS_BACKEND;CONFIGURATION;HOME"
        "OPTIONS;SOURCE_OVERRIDES" ${ARGN})
    if(NOT DEP_FILE OR NOT DEP_PROJECT_CONFIG OR DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "forgedeps_environment requires FILE and PROJECT_CONFIG")
    endif()
    if(NOT DEP_OUTPUT)
        set(DEP_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/forgedeps-environment.json")
    endif()
    if(NOT DEP_CONFIGURATION)
        set(DEP_CONFIGURATION "${CMAKE_BUILD_TYPE}")
    endif()
    if(NOT DEP_CONFIGURATION)
        message(FATAL_ERROR "A shared dependency environment needs CONFIGURATION for a multi-config generator")
    endif()
    set(_arguments environment --file "${DEP_FILE}" --project-config "${DEP_PROJECT_CONFIG}"
        --output "${DEP_OUTPUT}" --build-config "${DEP_CONFIGURATION}")
    if(DEP_CHECK OR NOT "$ENV{FORGEDEPS_ENVIRONMENT}" STREQUAL "" OR NOT "$ENV{FORGEDEPS_ENVIRONMENTS}" STREQUAL "")
        list(APPEND _arguments --check)
    endif()
    foreach(_field ONLY PROFILE TLS_BACKEND HOME)
        if(DEP_${_field})
            string(TOLOWER "${_field}" _option)
            string(REPLACE "_" "-" _option "${_option}")
            list(APPEND _arguments "--${_option}" "${DEP_${_field}}")
        endif()
    endforeach()
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    foreach(_language C CXX)
        if(CMAKE_${_language}_COMPILER)
            string(TOLOWER "${_language}" _option)
            list(APPEND _arguments "--${_option}" "${CMAKE_${_language}_COMPILER}")
        endif()
    endforeach()
    foreach(_variable CMAKE_GENERATOR CMAKE_GENERATOR_PLATFORM CMAKE_GENERATOR_TOOLSET)
        if(${_variable})
            list(APPEND _arguments --env "${_variable}=${${_variable}}")
        endif()
    endforeach()
    set(_variables CMAKE_TOOLCHAIN_FILE CMAKE_SYSROOT CMAKE_SYSROOT_COMPILE CMAKE_SYSROOT_LINK
        CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET
        CMAKE_MSVC_RUNTIME_LIBRARY CMAKE_MSVC_DEBUG_INFORMATION_FORMAT CMAKE_INTERPROCEDURAL_OPTIMIZATION
        CMAKE_POSITION_INDEPENDENT_CODE CMAKE_C_VISIBILITY_PRESET CMAKE_CXX_VISIBILITY_PRESET
        CMAKE_VISIBILITY_INLINES_HIDDEN
        CMAKE_C_COMPILER_ARG1 CMAKE_CXX_COMPILER_ARG1 CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET
        CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN
        CMAKE_C_COMPILER_LAUNCHER CMAKE_CXX_COMPILER_LAUNCHER
        CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS
        CMAKE_STATIC_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS CMAKE_C_STANDARD CMAKE_CXX_STANDARD
        CMAKE_C_STANDARD_REQUIRED CMAKE_CXX_STANDARD_REQUIRED CMAKE_C_EXTENSIONS CMAKE_CXX_EXTENSIONS
        CMAKE_ANDROID_NDK CMAKE_ANDROID_ARCH_ABI CMAKE_ANDROID_API CMAKE_ANDROID_STL_TYPE
        ANDROID_ABI ANDROID_PLATFORM ANDROID_STL)
    string(TOUPPER "${DEP_CONFIGURATION}" _configuration)
    foreach(_language C CXX EXE_LINKER SHARED_LINKER MODULE_LINKER STATIC_LINKER)
        list(APPEND _variables "CMAKE_${_language}_FLAGS_${_configuration}")
    endforeach()
    if(CMAKE_CROSSCOMPILING)
        list(APPEND _variables CMAKE_SYSTEM_NAME CMAKE_SYSTEM_VERSION CMAKE_SYSTEM_PROCESSOR)
    endif()
    foreach(_variable IN LISTS _variables)
        set(_value "${${_variable}}")
        if(CMAKE_TOOLCHAIN_FILE AND _variable MATCHES "_FLAGS($|_)" AND DEFINED CACHE{${_variable}})
            # NDK-style toolchains prepend their normal platform flags to
            # caller cache inputs. Pass those inputs, not the already-expanded
            # normal value, or the independent probe prepends the flags twice.
            get_property(_value CACHE "${_variable}" PROPERTY VALUE)
        endif()
        if(_variable MATCHES "^CMAKE_(C|CXX|EXE_LINKER|SHARED_LINKER|STATIC_LINKER)_FLAGS" AND DEFINED ${_variable})
            string(REPLACE ";" "\\;" _expected "${${_variable}}")
            list(APPEND _arguments "--expect-cmake=${_variable}=${_expected}")
        endif()
        if(DEFINED ${_variable} AND (NOT "${_value}" STREQUAL "" OR _variable MATCHES "_FLAGS($|_)"))
            string(REPLACE ";" "\\;" _value "${_value}")
            list(APPEND _arguments "--cmake-option=-D${_variable}=${_value}")
        endif()
    endforeach()
    foreach(_option IN LISTS DEP_OPTIONS)
        list(APPEND _arguments "--cmake-option=${_option}")
    endforeach()
    foreach(_source IN LISTS DEP_SOURCE_OVERRIDES)
        list(APPEND _arguments --source "${_source}")
    endforeach()
    _forgedeps_run(_result ${_arguments})
    forgedeps_use_environment(FILE "${DEP_OUTPUT}" OUTPUT_PREFIXES _prefixes)
    set(CMAKE_PREFIX_PATH "${CMAKE_PREFIX_PATH}" PARENT_SCOPE)
    set(FORGEDEPS_ENVIRONMENT "${DEP_OUTPUT}" PARENT_SCOPE)
    if(DEP_PREFIXES)
        set(${DEP_PREFIXES} "${_prefixes}" PARENT_SCOPE)
    endif()
endfunction()

# Output arguments name variables in the caller's scope. Source metadata is
# never modified by configure: the package owns validation and effective locks.
function(forgedeps_resolve)
    cmake_parse_arguments(DEP "OFFLINE" "NAME;FILE;REQUEST_VERSION;CACHE;STATE_DIR;VERSION;URL;SHA256;REVISION;TAG" "" ${ARGN})
    if(NOT DEP_NAME OR NOT DEP_FILE OR DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "forgedeps_resolve: expected NAME, FILE and output-variable arguments")
    endif()
    string(TOLOWER "${DEP_NAME}" _name)
    get_filename_component(_file "${DEP_FILE}" ABSOLUTE)
    string(SHA256 _identity "${_file}")
    set(_state "${CMAKE_BINARY_DIR}/deps/forgedeps")
    if(DEP_STATE_DIR)
        set(_state "${DEP_STATE_DIR}")
    endif()
    set(_effective "${_state}/${_identity}/dependencies.json")
    set(_cache "${DEP_CACHE}")
    if(NOT _cache)
        set(_cache "${_state}/downloads")
    endif()
    set(_arguments resolve --file "${_file}" --output "${_effective}"
        --cache "${_cache}" --only "${_name}")
    if(DEP_REQUEST_VERSION)
        list(APPEND _arguments --version "${_name}=${DEP_REQUEST_VERSION}")
    endif()
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    _forgedeps_run(_result ${_arguments})
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}" "${_effective}")
    endif()
    foreach(_field VERSION URL SHA256 REVISION TAG)
        if(DEP_${_field})
            string(TOLOWER "${_field}" _key)
            string(JSON _value ERROR_VARIABLE _error GET "${_result}" dependencies "${_name}" "${_key}")
            if(_error)
                message(FATAL_ERROR "ForgeDeps returned no ${_key} for ${_name}: ${_result}")
            endif()
            set(${DEP_${_field}} "${_value}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# Explicit metadata keeps this primitive usable by any schema/provider.
function(forgedeps_fetch_archive)
    cmake_parse_arguments(DEP "OFFLINE" "NAME;VERSION;URL;SHA256;CACHE;SOURCE_DIR;ARCHIVE" "" ${ARGN})
    if(DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "forgedeps_fetch_archive: invalid arguments")
    endif()
    foreach(_required NAME VERSION URL SHA256 CACHE SOURCE_DIR)
        if(NOT DEP_${_required})
            message(FATAL_ERROR "forgedeps_fetch_archive: missing ${_required}")
        endif()
    endforeach()
    set(_arguments fetch-archive --name "${DEP_NAME}" --version "${DEP_VERSION}"
        --url "${DEP_URL}" --sha256 "${DEP_SHA256}" --cache "${DEP_CACHE}")
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    _forgedeps_run(_result ${_arguments})
    string(JSON _source ERROR_VARIABLE _error GET "${_result}" source_dir)
    if(_error OR NOT IS_DIRECTORY "${_source}")
        message(FATAL_ERROR "ForgeDeps returned an invalid source directory: ${_result}")
    endif()
    file(TO_CMAKE_PATH "${_source}" _source)
    set(${DEP_SOURCE_DIR} "${_source}" PARENT_SCOPE)
    if(DEP_ARCHIVE)
        string(JSON _archive GET "${_result}" archive)
        file(TO_CMAKE_PATH "${_archive}" _archive)
        set(${DEP_ARCHIVE} "${_archive}" PARENT_SCOPE)
    endif()
endfunction()

function(forgedeps_fetch_file)
    cmake_parse_arguments(DEP "OFFLINE" "NAME;URL;SHA256;CACHE;AS;FILE;BASE" "" ${ARGN})
    if(DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "forgedeps_fetch_file: invalid arguments")
    endif()
    foreach(_required NAME URL SHA256 CACHE FILE)
        if(NOT DEP_${_required})
            message(FATAL_ERROR "forgedeps_fetch_file: missing ${_required}")
        endif()
    endforeach()
    set(_arguments fetch-file --name "${DEP_NAME}" --url "${DEP_URL}"
        --sha256 "${DEP_SHA256}" --cache "${DEP_CACHE}")
    if(DEP_AS)
        list(APPEND _arguments --as "${DEP_AS}")
    endif()
    if(DEP_OFFLINE)
        list(APPEND _arguments --offline)
    endif()
    _forgedeps_run(_result ${_arguments})
    string(JSON _file ERROR_VARIABLE _error GET "${_result}" file)
    if(_error OR NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
        message(FATAL_ERROR "ForgeDeps returned an invalid file: ${_result}")
    endif()
    file(TO_CMAKE_PATH "${_file}" _file)
    set(${DEP_FILE} "${_file}" PARENT_SCOPE)
    if(DEP_BASE)
        string(JSON _base GET "${_result}" base)
        file(TO_CMAKE_PATH "${_base}" _base)
        set(${DEP_BASE} "${_base}" PARENT_SCOPE)
    endif()
endfunction()
